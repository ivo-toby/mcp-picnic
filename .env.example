# Zugangsdaten hier zwischen den einfachen Anfuehrungszeichen eintragen.
# Die Anfuehrungszeichen erhalten Sonderzeichen wie $ und # unveraendert.
PICNIC_USERNAME=''
PICNIC_PASSWORD=''
PICNIC_COUNTRY_CODE=DE

# OpenAI Secure MCP Tunnel (only required for docker-compose.tunnel.yml):
# create a dedicated tunnel for Picnic.
# https://platform.openai.com/settings/organization/tunnels
# Runtime-Key mit Tunnels Read + Use; keinen Admin-Key verwenden.
CONTROL_PLANE_TUNNEL_ID=''
CONTROL_PLANE_API_KEY=''

# Standalone HTTP mode (required for docker-compose.yml).
# Generate with: openssl rand -hex 32
# Uncomment and replace with the generated value before starting that mode.
# HTTP_AUTH_TOKEN='replace-with-a-random-token'
# HTTP_AUTH_HEADER_NAME=x-mcp-token

# Lokale Tunnel-Statusseite: http://localhost:8091/ui
TUNNEL_UI_PORT=8091
LOG_LEVEL=info
